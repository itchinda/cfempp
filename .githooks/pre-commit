#!/usr/bin/env python3
import sys
import subprocess

# ANSI colors for Python
RED = '\033[91m'
GREEN = '\033[92m'
YELLOW = '\033[93m'
CYAN = '\033[96m'
BOLD = '\033[1m'
RESET = '\033[0m'

COPYRIGHT_HEADER = [
    "//************************************************************************",
    "// --- CFEM++ Library",
    "// ---",
    "// --- Copyright 2024-2026 Ismaël Tchinda Ngueyong et al.",
    "// --- ALL RIGHTS RESERVED",
    "// ---",
