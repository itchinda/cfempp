// 1. Tell Gmsh to use the OpenCASCADE CAD kernel
SetFactory("OpenCASCADE");

// 2. Load your STEP file
// Replace with your actual filename
v() = ShapeFromFile("wheel.STEP"); 

// 3. Optional: Force a fine mesh size to push CFEM++ to its limits
// Tweak these numbers depending on the physical scale of your CAD model

Mesh.MeshSizeMin = 0.25; 
Mesh.MeshSizeMax = 0.5;

// 4. (Crucial for FEM) Define a Physical Volume so CFEM++ can identify the domain
// This assigns the ID 1 to the generated volume
Physical Volume("Universe") = {v()};

//+
Physical Surface("Bande_de_roulement", 845) = {87, 80};
//+
Physical Surface("Caoutchouc", 846) = {86, 76, 82, 77};
//+

Physical Surface("Mag_external_surface", 847) = {19, 28, 17, 30, 74, 1, 75, 6, 70, 2, 10, 29, 9, 31, 15, 18, 3, 73, 4, 72, 5, 71, 27, 22, 11, 16, 8, 68, 14, 21, 7, 69, 55, 20, 49, 45, 38, 40, 39, 41, 46, 50, 57, 56, 60, 33, 51, 42, 35, 44, 53, 34, 54, 37, 64, 32, 36, 61, 62, 58, 52, 67, 65, 66, 63, 59, 48, 43, 47, 13, 23};
